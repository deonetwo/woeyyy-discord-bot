# Discord Bot Token (from Discord Developer Portal)
DISCORD_BOT_TOKEN=your_bot_token_here

# Execution Mode:
# 'server' = Cached download for high VPS stability (default)
# 'local'  = Zero-download direct streaming for local PCs
BOT_MODE=server

# Audio Cache Limits (LRU Storage Protection)
# Rule of thumb: Average YouTube audio track (Opus ~160kbps) = ~4 - 5 MB.
# Safe recommended ratios:
# - 50 tracks  -> MAX_CACHE_MB=500   | MAX_CACHE_FILES=50
# - 100 tracks -> MAX_CACHE_MB=800   | MAX_CACHE_FILES=100
# - 200 tracks -> MAX_CACHE_MB=1200  | MAX_CACHE_FILES=200  (Recommended for 200 tracks)
# - 500 tracks -> MAX_CACHE_MB=3000  | MAX_CACHE_FILES=500
MAX_CACHE_MB=500
MAX_CACHE_FILES=50
