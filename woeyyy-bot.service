[Unit]
Description=Woeyyy Discord Bot Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/woeyyy-discord-bot
Environment=PYTHONUNBUFFERED=1
# Option A: specify token via environment variable
Environment=DISCORD_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
# Option B: or read token from .env file
# EnvironmentFile=/home/ubuntu/woeyyy-discord-bot/.env
ExecStart=/home/ubuntu/woeyyy-discord-bot/venv/bin/python main.py --daemon
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
